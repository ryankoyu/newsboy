# ============================================================================
# BRIEFLY web/ — environment variables
# Copy to .env.local for local dev (`cp .env.example .env.local`), or enter
# in Vercel Project Settings > Environment Variables for deployment.
# NEVER commit an .env.local (or any file with real values) — .gitignore
# already excludes .env* except this .example file.
# ============================================================================

# --- Admin review console -----------------------------------------------
# production-readiness.md §2, docs/design/a1-architecture.md §2 [7].
# Simple shared-password gate for /admin — NOT real multi-user auth.
# Replace with Supabase Auth once Supabase is connected (see web/src/lib/admin/auth.ts).
# Pick any password yourself (this isn't issued by a service) — e.g. a long
# random string from a password manager. Required for /admin to be usable.
ADMIN_PASSWORD=

# Optional: separate secret for signing the admin session cookie. Falls back
# to ADMIN_PASSWORD if unset (fine for local/dev; set explicitly in prod so
# rotating the login password doesn't also invalidate active sessions).
ADMIN_SESSION_SECRET=

# Optional: override the pipeline output directory the admin console reads
# from. Defaults to ../pipeline/output relative to where `npm run dev`/
# `npm run build` is invoked (assumes running from the web/ directory).
# Leave unset on Vercel — that directory doesn't exist there (it's
# gitignored, never pushed), which is expected: see ADMIN_ENABLED below.
PIPELINE_OUTPUT_DIR=

# Optional explicit kill switch for /admin. Leave unset to auto-detect
# (the console already shows a graceful "Supabase 연결 후 사용 가능합니다"
# notice instead of erroring when pipeline/output isn't found — e.g. on a
# fresh Vercel deploy). Set to "false" to force it off even where the
# directory happens to exist. Any other value (or unset) = enabled.
ADMIN_ENABLED=

# --- Supabase --------------------------------------------------------------
# The reader and the desk both go through Supabase now. Which variable name a
# value carries decides which of them sees it, and getting that wrong does not
# raise an error — it silently serves the committed seed. If a deployed site is
# showing month-old articles, this section is the first place to look.
#
# Get these from: Supabase dashboard > Project Settings > API.

# --- Read side: the reader (browser + server rendering) ---------------------
# NEXT_PUBLIC_ is not decoration. Next.js only exposes variables with that
# prefix to browser code, and web/src/lib/data/index.ts reads exactly these two
# names. Set both, or neither: with one of the pair missing the app logs a
# warning and falls back to the seed; with both missing it falls back silently.
#
# Both are required in Vercel for the site to serve real articles.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key — safe in the browser. Row-level security limits it to
# published articles and to a signed-in reader's own rows (0001_schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Write side: publishing, on the operator's machine only ----------------
# publishEdition/publishToSupabase.ts flips articles to `published`, which the
# anon key cannot do by policy. These two are how the desk does it.
#
# Leave BOTH BLANK IN VERCEL. The service role key bypasses row-level security
# entirely; a deployed site holding it could publish without anyone approving,
# which is the one thing the architecture exists to prevent (a1 §2 [7]).
# Publishing is an action taken on your own machine.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

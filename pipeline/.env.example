# ============================================================================
# BRIEFLY pipeline/ — environment variables
# Copy to .env for local dev (`cp .env.example .env`), or enter as GitHub
# Actions repo secrets for the daily-pipeline workflow (Settings > Secrets
# and variables > Actions — NOT repo Variables, these are secrets).
# NEVER commit a .env (or any file with real values) — .gitignore already
# excludes .env (see pipeline/.gitignore).
# ============================================================================

# --- LLM provider ----------------------------------------------------------
# Anthropic Console (https://console.anthropic.com) > API Keys. Required
# unless LLM_PROVIDER=mock. The pipeline fails fast with a clear error if
# this is missing and LLM_PROVIDER=anthropic (the default).
# ⚠ If this key has ever been pasted into a chat/AI conversation, treat it as
# compromised and issue a NEW key before using it for real — do not reuse an
# exposed key (see docs/DEPLOYMENT.md "API 키 회전").
ANTHROPIC_API_KEY=

# "anthropic" (default, real rewrite/extract/select calls) or "mock"
# (deterministic fake output, no API calls, no cost — for dry runs/demos).
LLM_PROVIDER=anthropic

# Use the Anthropic Batch API for the rewrite stage (~50% cheaper, but
# results can take up to ~1h, sometimes longer). true/false. If unset: the
# pipeline defaults to true automatically on a GitHub Actions *scheduled*
# run (the nightly cron has hours of slack) and false otherwise (manual
# runs want results now). Explicit false always wins. See src/index.ts.
USE_BATCH_API=

# --- Storage -----------------------------------------------------------
# "local" (default) — writes pipeline/output/*.json, no external service
# needed. "supabase" — writes into the real Supabase schema (requires both
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY below).
STORAGE=local

# Supabase dashboard > Project Settings > API > Project URL.
SUPABASE_URL=

# Supabase dashboard > Project Settings > API > service_role key (NOT the
# anon/public key — the pipeline's writes must bypass Row Level Security to
# insert 검수 대기(review) content; see src/storage/supabase.ts header).
# NEVER expose this key to a browser or client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ----------------------------------------------------------
# Cap the number of articles processed in one run (cheaper test runs).
# Leave empty for the full Top 10.
MAX_ARTICLES=

# GITHUB_EVENT_NAME is set automatically by GitHub Actions (not something
# you set by hand) — used only to detect a *scheduled* run for the
# USE_BATCH_API default above. Irrelevant for local dev.
